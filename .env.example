# Copy to `.env.local` and fill in from your Supabase project settings
# (Project Settings -> API). The anon key is safe to ship in a browser bundle;
# Row Level Security is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Enables the "Push notifications" toggle (desktop Chrome/Edge/Firefox/
# Safari). Run `npx web-push generate-vapid-keys` — put the *public* key here and
# on Vercel; the *private* key goes into the `push` Edge Function's secrets.
# See supabase/functions/push/index.ts for the full setup.
# VITE_VAPID_PUBLIC_KEY=

# Optional. Cloudflare Turnstile site key. When set, the Turnstile widget is
# shown at the bottom of the sign-in and sign-up forms and a token is required
# to submit. Verify the token server-side (Supabase Edge Function / hook) before
# trusting it.
# VITE_TURNSTILE_SITE_KEY=

# Local testing only. Set to "true" AND turn OFF "Confirm email" in Supabase
# (Authentication -> Sign In / Providers -> Email) so sign-up skips the 6-digit
# email code screen and goes straight to the app. Remove this once SMTP is
# configured and you turn email confirmation back on.
# VITE_SKIP_EMAIL_CONFIRM=true
